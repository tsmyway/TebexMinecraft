@{
    ViewData["Title"] = "Orden Confirmada";
    string orderCode = ViewBag.OrderCode as string ?? "N/A";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 text-center">
            <div class="card-header bg-success text-white py-4">
                <h2 class="mb-1">🎉 ¡Orden Registrada!</h2>
                <p class="mb-0">Tu pedido ha sido creado y está listo para ser procesado.</p>
            </div>
            <div class="card-body p-4">
                <div class="bg-light p-3 rounded mb-4 border">
                    <span class="text-muted d-block small mb-1">CÓDIGO DE ORDEN:</span>
                    <h3 class="fw-bold font-monospace text-primary mb-0">@orderCode</h3>
                </div>

                <div class="card border-warning mb-4">
                    <div class="card-header bg-warning bg-opacity-10 text-dark fw-bold">
                        Modo Sandbox / Prueba de Pagos
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3">
                            En este entorno de desarrollo puedes simular la confirmación del pago. 
                            Al presionar el botón inferior, la API cambiará la orden a estado 
                            <strong>PAID</strong> y enviará los beneficios directamente a las tablas 
                            del servidor de Minecraft.
                        </p>
                        <form asp-action="SimulatePayment" method="post">
                            <input type="hidden" name="orderCode" value="@orderCode" />
                            <button type="submit" class="btn btn-warning btn-lg fw-bold px-4">
                                ⚡ Simular Pago Aprobado
                            </button>
                        </form>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Ranks" asp-action="Index" class="btn btn-outline-secondary">Volver al Catálogo</a>
                    <a asp-action="Index" class="btn btn-outline-primary">Ver Carrito</a>
                </div>
            </div>
        </div>
    </div>
</div>