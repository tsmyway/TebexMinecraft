@{
    ViewData["Title"] = "Orden Generada";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7">
        <div class="card product-card p-5 text-center shadow-lg">
            
            <div class="mb-3">
                <i class="bi bi-check2-circle text-success" style="font-size: 4rem;"></i>
            </div>

            <h2 class="fw-extrabold text-white mb-2" style="font-family: 'Rajdhani', sans-serif;">
                ¡ORDEN GENERADA EXITOSAMENTE!
            </h2>
            <p class="text-light-50 small mb-4">
                Tu orden ha sido registrada en el sistema y se encuentra pendiente de acreditación.
            </p>

            <div class="bg-dark p-3 rounded-3 border border-secondary border-opacity-25 mb-4">
                <span class="text-light-50 small d-block mb-1">CÓDIGO DE ORDEN:</span>
                <span class="fs-4 font-monospace fw-bold text-warning tracking-wider">@ViewBag.OrderCode</span>
            </div>

            <div class="alert alert-gamer alert-warning text-start mb-4">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Modo Simulación:</strong> Como estás en el entorno de desarrollo, presiona el botón inferior para marcar la orden como pagada y sincronizar los beneficios de inmediato con tu cuenta.
            </div>

            <form asp-action="SimulatePayment" method="post" class="mb-3">
                <input type="hidden" name="orderCode" value="@ViewBag.OrderCode" />
                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold py-3">
                    ⚡ Simular Pago Aprobado
                </button>
            </form>

            <a asp-controller="Ranks" asp-action="Index" class="btn btn-outline-light w-100 py-2 mt-2">
                Volver a la Tienda
            </a>
        </div>
    </div>
</div>