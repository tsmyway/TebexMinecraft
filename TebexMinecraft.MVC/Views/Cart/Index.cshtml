@model List<TebexMinecraft.Modelos.OrderItem>
@{
    ViewData["Title"] = "Tu Carrito";
    decimal total = Model?.Sum(i => i.UnitPrice * i.Quantity) ?? 0;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card product-card p-4 shadow-lg">
            <h2 class="fw-extrabold text-white mb-4" style="font-family: 'Rajdhani', sans-serif;">
                <i class="bi bi-cart3 text-warning me-2"></i>Resumen de tu Cesta
            </h2>

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x fs-1 text-light-50"></i>
                    <h4 class="text-light-50 mt-3">Tu carrito está vacío</h4>
                    <p class="text-muted small">Explora el catálogo para agregar ventajas y cosméticos.</p>
                    <a asp-controller="Ranks" asp-action="Index" class="btn btn-buy-custom px-4 py-2 mt-2">
                        Explorar Rangos
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-4">
                        <thead>
                            <tr class="text-light-50 text-uppercase small border-secondary">
                                <th>Artículo</th>
                                <th>Tipo</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-end">Precio Unitario</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                <tr>
                                    <td>
                                        <span class="fw-bold text-white">@item.ProductName</span>
                                        
                                        @if (!string.IsNullOrEmpty(item.CustomInput))
                                        {
                                            <div class="small text-warning font-monospace mt-1">
                                                <i class="bi bi-chat-dots me-1"></i>Motivo: @item.CustomInput
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-25 text-light-50 border border-secondary border-opacity-25 font-monospace">
                                            @item.ProductCategory
                                        </span>
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end font-monospace">$@item.UnitPrice.ToString("0.00")</td>
                                    <td class="text-end fw-bold text-warning font-monospace">$@((item.UnitPrice * item.Quantity).ToString("0.00"))</td>
                                    <td class="text-center">
                                        <form asp-action="Remove" method="post" class="d-inline">
                                            <input type="hidden" name="index" value="@i" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row align-items-center mt-3 pt-3 border-top border-secondary border-opacity-25">
                    <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                        <a asp-controller="Ranks" asp-action="Index" class="text-light-50 text-decoration-none small">
                            <i class="bi bi-arrow-left me-1"></i> Continuar navegando
                        </a>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <span class="text-light-50 me-2 fs-5">Total a Pagar:</span>
                        <span class="product-price fs-2">$@total.ToString("0.00")</span>

                        <form asp-action="Checkout" method="post" class="mt-3">
                            <button type="submit" class="btn btn-buy-custom w-100 py-3 fs-5 shadow">
                                <i class="bi bi-credit-card-2-front-fill me-2"></i> Proceder al Pago Seguro
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>