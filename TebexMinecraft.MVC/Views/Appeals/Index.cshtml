@model List<TebexMinecraft.Modelos.Appeal>
@{
    ViewData["Title"] = "Pases de Desbaneo";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-extrabold text-uppercase text-white mb-0" style="font-family: 'Rajdhani', sans-serif; letter-spacing: 1px;">
            <i class="bi bi-life-preserver text-danger me-2"></i>Desbaneos y Apelaciones
        </h2>
        <span class="text-light-50 small">Restaura el acceso a tu cuenta o retira sanciones activas del servidor.</span>
    </div>
    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2">
        <i class="bi bi-shield-exclamation me-1"></i> Trámite Único
    </span>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var appeal in Model)
    {
        <div class="col">
            <div class="card h-100 product-card p-3 d-flex flex-column border-danger border-opacity-25">
                
                <div class="text-center py-3 border-bottom border-secondary border-opacity-25">
                    <span class="badge bg-danger bg-opacity-10 text-danger product-badge-rank px-3 py-1 mb-2 font-monospace">
                        [@appeal.ServerAppeal.ToUpper()]
                    </span>
                    <h3 class="fw-bold text-white mb-0">@appeal.Name</h3>
                </div>

                <div class="card-body text-center d-flex flex-column px-2 py-4">
                    <div class="product-price text-danger mb-3">
                        <span class="fs-4 text-light-50 align-top">$</span>@appeal.Price.ToString("0.00")
                        <small class="fs-6 text-light-50 fw-normal">/ trámite</small>
                    </div>

                    <p class="text-light-50 small">
                        Solicitud formal de apelacion vinculada al UUID verificado de tu cuenta de Minecraft.
                    </p>

                    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto pt-3 text-start">
                        <input type="hidden" name="ProductCategory" value="APPEAL" />
                        <input type="hidden" name="ProductInternalName" value="@appeal.ServerAppeal" />
                        <input type="hidden" name="ProductName" value="@appeal.Name" />
                        <input type="hidden" name="UnitPrice" value="@appeal.Price" />
                        <input type="hidden" name="Quantity" value="1" />
                        
                        <div class="mb-3">
                            <label class="form-label text-light-50 small fw-bold">
                                <i class="bi bi-chat-left-text me-1 text-danger"></i>Motivo de la Apelación:
                            </label>
                            <textarea name="CustomInput" class="form-control bg-dark text-white border-secondary border-opacity-50 small" 
                                      rows="2" placeholder="Explica brevemente la sanción o descargo..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-outline-danger w-100 py-3 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-unlock-fill fs-5"></i> Tramitar Apelación
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>