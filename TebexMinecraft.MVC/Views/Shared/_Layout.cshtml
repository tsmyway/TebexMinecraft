@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@using System.Linq
@using TebexMinecraft.Modelos
@{
    var userJson = Context.Session.GetString("MinecraftStoreUser");
    var user = string.IsNullOrEmpty(userJson) ? null : JsonConvert.DeserializeObject<User>(userJson);

    var cartJson = Context.Session.GetString("MinecraftStoreCart");
    var cart = string.IsNullOrEmpty(cartJson) ? new List<OrderItem>() : JsonConvert.DeserializeObject<List<OrderItem>>(cartJson);

    int cartCount = 0;
    if (cart != null && cart.Any())
    {
        cartCount = cart.Sum(i => i.Quantity);
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tienda Oficial Minecraft</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/store-theme.css" />
</head>
<body class="bg-store text-light">

    <div class="top-server-bar py-2">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="status-dot"></span>
                <small class="text-uppercase tracking-wider fw-bold text-light-50">¡Servidor En Línea!</small>
                <div class="ip-badge ms-2" onclick="navigator.clipboard.writeText('mc.tudominio.com'); alert('¡IP copiada al portapapeles!');" role="button">
                    <span class="text-warning">mc.phoenix.com</span>
                    <i class="bi bi-copy ms-1 text-light-50"></i>
                </div>
            </div>
            <div>
                <small class="text-light-50">⚡ Todas las compras son automáticas y seguras</small>
            </div>
        </div>
    </div>
    
    <nav class="navbar navbar-expand-lg navbar-dark store-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 fw-extrabold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shield-fill-check text-warning fs-3"></i>
                <span class="brand-title">PHOENIX<span class="text-warning">MC</span></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#storeNav">
                <i class="bi bi-list fs-2 text-warning"></i>
            </button>

            <div class="collapse navbar-collapse" id="storeNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill text-warning me-1"></i> Inicio
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ranks" ? "active" : "")" asp-controller="Ranks" asp-action="Index">
                            <i class="bi bi-star-fill text-warning me-1"></i> Rangos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Prefixes" ? "active" : "")" asp-controller="Prefixes" asp-action="Index">
                            <i class="bi bi-chat-quote-fill text-info me-1"></i> Prefijos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Consumables" ? "active" : "")" asp-controller="Consumables" asp-action="Index">
                            <i class="bi bi-box-seam-fill text-success me-1"></i> Consumibles
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-btn @(ViewContext.RouteData.Values["controller"]?.ToString() == "Appeals" ? "active" : "")" asp-controller="Appeals" asp-action="Index">
                            <i class="bi bi-life-preserver text-danger me-1"></i> Desbaneos
                        </a>
                    </li>
                </ul>
                
                <div class="d-flex align-items-center gap-3">
                    @if (user != null)
                    {
                        <div class="user-pill d-flex align-items-center gap-2">
                            <img src="https://mc-heads.net/avatar/@user.Username/36" alt="@user.Username" class="skin-head" />
                            <div class="text-start d-none d-sm-block">
                                <span class="d-block fw-bold text-white small">@user.Username</span>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="logout-link btn btn-link p-0 text-danger border-0">Salir</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-warning btn-sm fw-bold px-3 py-2 rounded-pill">
                            <i class="bi bi-controller me-1"></i> Ingresar Nick
                        </a>
                    }
                    
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-cart position-relative rounded-pill px-3 py-2">
                        <i class="bi bi-basket2-fill"></i>
                        <span class="d-none d-md-inline ms-1 fw-bold">Carrito</span>
                        @if (cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-dark">
                                @cartCount
                            </span>
                        }
                    </a>
                </div>
            </div>
        </div>
    </nav>
    
    <header class="store-hero">
        <div class="container text-center py-5">
            <span class="badge bg-warning text-dark text-uppercase px-3 py-2 fw-bold tracking-wider mb-3">
                Gran Apertura & Temporada 2026
            </span>
            <h1 class="display-4 fw-extrabold text-uppercase text-white hero-title">
                Mejora Tu Experiencia en el Servidor
            </h1>
            <p class="lead text-light-50 mx-auto" style="max-width: 650px;">
                Adquiere rangos exclusivos, cosméticos únicos y ventajas permanentes con activación inmediata dentro del juego.
            </p>
        </div>
    </header>
    
    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-gamer alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["Success"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-gamer alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["Warning"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-gamer alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-x-octagon-fill me-2 fs-5"></i> @TempData["Error"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>
    
    <main class="container my-4 pb-5">
        @RenderBody()
    </main>

    <footer class="store-footer border-top border-secondary border-opacity-10 py-5 mt-auto">
        <div class="container text-center">
            <p class="text-light-50 mb-2">
                © 2026 <strong>Phoenix MC</strong>. Todos los derechos reservados.
            </p>
            <p class="small text-light-25 mb-0">
                No estamos afiliados ni respaldados por Mojang AB o Microsoft. Minecraft es una marca registrada de Mojang AB.
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>