@model List<TebexMinecraft.Modelos.Rank>
@{
    ViewData["Title"] = "Catálogo de Rangos";
    var ownedRanks = ViewBag.OwnedRanks as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-extrabold text-uppercase text-white mb-0" style="font-family: 'Rajdhani', sans-serif; letter-spacing: 1px;">
            <i class="bi bi-gem text-warning me-2"></i>Rangos VIP y Permanentes
        </h2>
        <span class="text-light-50 small">Selecciona el paquete ideal para desbloquear ventajas dentro del servidor.</span>
    </div>
    <span class="badge bg-secondary bg-opacity-25 border border-secondary border-opacity-25 px-3 py-2">
        <i class="bi bi-clock-history me-1"></i> Activación al instante
    </span>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var rank in Model)
    {
        bool yaAdquirido = ownedRanks.Contains(rank.ServerRank, StringComparer.OrdinalIgnoreCase);

        <div class="col">
            <div class="card h-100 product-card @(yaAdquirido ? "owned-card" : "") p-3 d-flex flex-column">
                
                <div class="text-center py-3 border-bottom border-secondary border-opacity-25">
                    <span class="badge bg-warning bg-opacity-10 text-warning product-badge-rank px-3 py-1 mb-2">
                        @rank.ServerRank.ToUpper()
                    </span>
                    <h3 class="fw-bold text-white mb-0">@rank.Name</h3>
                </div>
                
                <div class="card-body text-center d-flex flex-column px-2 py-4">
                    <div class="product-price mb-3">
                        <span class="fs-4 text-light-50 align-top">$</span>@rank.Price.ToString("0.00")
                        <small class="fs-6 text-light-50 fw-normal">/ para siempre</small>
                    </div>

                    <p class="text-light-50 small flex-grow-1">
                        @(string.IsNullOrEmpty(rank.Description) ? "Acceso completo a kits VIP, comandos de teletransporte, canales exclusivos de chat y multiplicador de dinero." : rank.Description)
                    </p>
                    
                    <div class="mt-auto pt-3">
                        @if (yaAdquirido)
                        {
                            <button class="btn btn-outline-success w-100 py-3 fw-bold rounded-3" disabled>
                                <i class="bi bi-patch-check-fill me-2 fs-5"></i> Ya Adquirido
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="ProductCategory" value="RANK" />
                                <input type="hidden" name="ProductInternalName" value="@rank.ServerRank" />
                                <input type="hidden" name="ProductName" value="@rank.Name" />
                                <input type="hidden" name="UnitPrice" value="@rank.Price" />
                                <input type="hidden" name="Quantity" value="1" />

                                <button type="submit" class="btn btn-buy-custom w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-cart-plus-fill fs-5"></i> Añadir a la Cesta
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>