@model List<TebexMinecraft.Modelos.Prefix>
@{
    ViewData["Title"] = "Tags y Prefijos";
    var ownedPrefixes = ViewBag.OwnedPrefixes as List<string> ?? new List<string>();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-extrabold text-uppercase text-white mb-0" style="font-family: 'Rajdhani', sans-serif; letter-spacing: 1px;">
            <i class="bi bi-chat-quote-fill text-info me-2"></i>Prefijos y Tags de Chat
        </h2>
        <span class="text-light-50 small">Destaca en el chat y tabulador con títulos cosméticos permanentes.</span>
    </div>
    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2">
        <i class="bi bi-palette-fill me-1"></i> Cosméticos Globales
    </span>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var prefix in Model)
    {
        bool yaAdquirido = ownedPrefixes.Contains(prefix.ServerTag, StringComparer.OrdinalIgnoreCase);

        <div class="col">
            <div class="card h-100 product-card @(yaAdquirido ? "owned-card" : "") p-3 d-flex flex-column">
                
                <div class="text-center py-3 border-bottom border-secondary border-opacity-25">
                    <span class="badge bg-info bg-opacity-10 text-info product-badge-rank px-3 py-1 mb-2 font-monospace">
                        [@prefix.ServerTag.ToUpper()]
                    </span>
                    <h3 class="fw-bold text-white mb-0">@prefix.Name</h3>
                </div>

                <div class="card-body text-center d-flex flex-column px-2 py-4">
                    <div class="product-price mb-3">
                        <span class="fs-4 text-light-50 align-top">$</span>@prefix.Price.ToString("0.00")
                        <small class="fs-6 text-light-50 fw-normal">/ permanente</small>
                    </div>

                    <p class="text-light-50 small flex-grow-1">
                        Título cosmético visible en todas las modalidades, menús de tabulación y chat público del servidor.
                    </p>

                    <div class="mt-auto pt-3">
                        @if (yaAdquirido)
                        {
                            <button class="btn btn-outline-success w-100 py-3 fw-bold rounded-3" disabled>
                                <i class="bi bi-patch-check-fill me-2 fs-5"></i> Tag Ya Adquirido
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="ProductCategory" value="PREFIX" />
                                <input type="hidden" name="ProductInternalName" value="@prefix.ServerTag" />
                                <input type="hidden" name="ProductName" value="@prefix.Name" />
                                <input type="hidden" name="UnitPrice" value="@prefix.Price" />
                                <input type="hidden" name="Quantity" value="1" />

                                <button type="submit" class="btn btn-buy-custom w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-cart-plus-fill fs-5"></i> Añadir Tag
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>